        D1[delivery_max_distance_km] -->|in 2 tables| DC1A[delivery_config]
        D1 -->|in 2 tables| SC1A[service_configs]
        
        D2[delivery_min_order] -->|in 3 places| SC1B[service_configs<br/>global setting]
        D2 -->|in 3 places| DA1A[delivery_areas<br/>per-area setting]
        D2 -->|in 3 places| DZ1A[delivery_zones<br/>per-zone setting]
        
        D3[delivery_fee] -->|in 3 places| DC1B[delivery_config<br/>restaurant_delivery_charge]
        D3 -->|in 3 places| DA1B[delivery_areas<br/>delivery_fee]
