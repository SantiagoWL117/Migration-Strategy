        D3A[delivery_fee] -->|per-zone| DZ2C[delivery_zones<br/>delivery_fee_cents]
        D4A[geometry] -->|only here| DZ2D[delivery_zones<br/>zone_geometry]
    end
    
    style D1 fill:#ff6b6b
    style D2 fill:#ff6b6b
    style D3 fill:#ff6b6b
    style D4 fill:#ff6b6b
    
    style D1A fill:#51cf66
    style D2A fill:#51cf66
    style D3A fill:#51cf66
    style D4A fill:#51cf66

%% ========================================
%% Configuration Conflict Example
%% ========================================

graph TB
    subgraph "BEFORE: Configuration Conflict"
        CONFIG[restaurant_delivery_config]
        CONFIG --> M1[delivery_method = 'radius']
        CONFIG --> R1[delivery_radius_km = NULL]
        CONFIG --> P1[use_polygon_areas = TRUE]
        
        M1 -.says.-> S1[Should use radius]
        R1 -.but.-> S2[No radius set!]
        P1 -.actually.-> S3[Uses polygon areas]
        
        S1 --> X1[❌ CONFLICT]
        S2 --> X1
        S3 --> X1
    end
    
    subgraph "AFTER: Clear Configuration"
        CONFIG2[restaurant_delivery_config]
        CONFIG2 --> M2[delivery_method = 'zones']
        CONFIG2 --> Z1[Look up zones →]
        Z1 --> ZONES[restaurant_delivery_zones<br/>Single source of truth]
        
        ZONES --> G1[zone_geometry: PostGIS Polygon]
        ZONES --> F1[delivery_fee_cents: $300]
        ZONES --> O1[minimum_order_cents: $1700]
        
        M2 --> X2[✅ CLEAR]
        Z1 --> X2
    end
    
    style X1 fill:#ff6b6b
    style X2 fill:#51cf66

%% ========================================
%% Query Complexity Comparison
%% ========================================

graph LR
    subgraph "BEFORE: Complex Query (4 table joins)"
        Q1[Get Delivery Info]
        Q1 --> T1[JOIN restaurant_delivery_config]
        Q1 --> T2[JOIN restaurant_service_configs]
        Q1 --> T3[JOIN restaurant_delivery_areas]
        Q1 --> T4[JOIN restaurant_delivery_fees]
        
        T1 --> R1[method?]
        T2 --> R2[enabled?]
        T3 --> R3[geometry?]
        T4 --> R4[fee?]
        
        R1 --> M1[Merge conflicting data]
        R2 --> M1
        R3 --> M1
        R4 --> M1
        
        M1 --> RES1[Result]
    end
    
    subgraph "AFTER: Simple Query (2 table joins)"
        Q2[Get Delivery Info]
        Q2 --> T5[JOIN restaurant_delivery_config]
        Q2 --> T6[JOIN restaurant_delivery_zones]
        
        T5 --> R5[enabled?]
        T6 --> R6[geometry + fee + minimum]
        
        R5 --> RES2[Result]
        R6 --> RES2
    end
    
    style M1 fill:#ff6b6b
    style RES2 fill:#51cf66

%% ========================================
%% Migration Flow
%% ========================================

graph TD
    subgraph "Phase 1: Data Consolidation"
        P1A[restaurant_delivery_areas<br/>16 records]
        P1B[restaurant_delivery_fees<br/>43 records]
        P1C[restaurant_delivery_companies<br/>15 records]
        
        P1A -->|migrate geometry + pricing| TARGET1[restaurant_delivery_zones]
        P1B -->|migrate tier 1 fees| TARGET1
        P1C -->|consolidate to JSONB| TARGET2[restaurant_delivery_config<br/>active_partners]
    end
    
    subgraph "Phase 2: Schema Updates"
        P2A[restaurant_service_configs]
        P2B[restaurant_delivery_config]
        
        P2A -->|extract delivery settings| NEW1[restaurant_service_settings]
        P2B -->|remove duplicate columns| NEW2[restaurant_delivery_config<br/>simplified]
    end
    
    subgraph "Phase 3: Cleanup"
        P3A[_archived_delivery_fees]
        P3B[_archived_delivery_areas]
        P3C[_archived_delivery_companies]
        P3D[_archived_service_configs]
        
        P3A -->|monitor 2 weeks| DROP1[DROP TABLE]
        P3B -->|monitor 2 weeks| DROP1
        P3C -->|monitor 2 weeks| DROP1
        P3D -->|monitor 2 weeks| DROP1
    end
    
    TARGET1 --> P2A
    TARGET2 --> P2B
    NEW1 --> P3A
    NEW2 --> P3B
    
    style P1A fill:#ff6b6b
    style P1B fill:#ff6b6b
    style P1C fill:#ff6b6b
    style P2A fill:#ffd43b
    style P2B fill:#ffd43b
    style TARGET1 fill:#51cf66
    style TARGET2 fill:#51cf66
    style NEW1 fill:#51cf66
    style NEW2 fill:#51cf66

