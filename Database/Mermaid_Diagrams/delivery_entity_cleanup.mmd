%% ========================================
%% Delivery Entity Cleanup - Visual Comparison
%% ========================================

graph TB
    subgraph "BEFORE: 6 Tables, 3 Systems, ~150 Columns"
        R1[restaurants] --> DC1[restaurant_delivery_config<br/>24 columns<br/>⚠️ BLOATED]
        R1 --> SC1[restaurant_service_configs<br/>25 columns<br/>⚠️ MIXED CONCERNS]
        R1 --> DZ1[restaurant_delivery_zones<br/>17 columns<br/>✅ GOOD but unused]
        R1 --> DF1[restaurant_delivery_fees<br/>18 columns<br/>❌ LEGACY]
        R1 --> DA1[restaurant_delivery_areas<br/>21 columns<br/>❌ DUPLICATE]
        R1 --> DCO1[restaurant_delivery_companies<br/>15 columns<br/>❌ UNUSED]
        
        DC1 -.duplicate.-> SC1
        DC1 -.duplicate.-> DA1
        DF1 -.duplicate.-> DZ1
        DA1 -.duplicate.-> DZ1
        DCO1 -.should be in.-> DC1
    end
    
    subgraph "AFTER: 3 Tables, 1 System, ~80 Columns"
        R2[restaurants] --> DC2[restaurant_delivery_config<br/>15 columns<br/>✅ SIMPLIFIED]
        R2 --> DZ2[restaurant_delivery_zones<br/>17 columns<br/>✅ PRIMARY SYSTEM]
        R2 --> SS2[restaurant_service_settings<br/>19 columns<br/>✅ SEPARATED CONCERNS]
        
        DC2 --> DZ2
        SS2 --> DZ2
    end
    
    %% Migration arrows
    DC1 -.migrate.-> DC2
    SC1 -.migrate.-> SS2
    DZ1 -.unchanged.-> DZ2
    DF1 -.migrate data.-> DZ2
    DA1 -.migrate data.-> DZ2
    DCO1 -.consolidate.-> DC2
    
    style DC1 fill:#ff6b6b
    style SC1 fill:#ff6b6b
    style DF1 fill:#ff0000
    style DA1 fill:#ff0000
    style DCO1 fill:#ff0000
    
    style DC2 fill:#51cf66
    style DZ2 fill:#51cf66
    style SS2 fill:#51cf66
    
    style DZ1 fill:#ffd43b

